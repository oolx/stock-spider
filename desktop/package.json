{
  "name": "stock-desktop",
  "version": "1.0.0",
  "description": "A股实时行情桌面客户端（Electron）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.stock.desktop",
    "productName": "AStock",
    "artifactName": "AStock-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend",
        "to": "renderer/frontend"
      },
      {
        "from": "../salary_calculation",
        "to": "renderer/salary_calculation"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "category": "Office;Finance",
      "synopsis": "A股实时行情桌面客户端"
    }
  }
}
